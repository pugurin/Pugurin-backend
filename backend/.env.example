# 모든 값은 선택입니다. 서버는 가짜 데이터를 쓰지 않습니다. 실데이터(DB 또는 .cache)가 없으면 "데이터 없음"(503 DATA_NOT_READY)으로 응답합니다.
PUGURIN_APP_ENV=local

# DB·Redis. 비워 두면 파일 캐시·메모리만으로 동작한다 (docker compose는 알아서 채운다)
# PUGURIN_DATABASE_URL=postgresql+asyncpg://pugurin:pugurin@localhost:5432/pugurin
# PUGURIN_REDIS_URL=redis://localhost:6379/0
# worker(docker compose --profile worker)가 매일 수집·적재를 시작하는 시각(KST, 기본 4)
# PUGURIN_WORKER_RUN_HOUR=4
# 줌 → 집계 단위 임계치 (표준 웹 메르카토르 줌): 12 미만=시군구, 12~13=동, 14 이상=단지/필지
PUGURIN_ZOOM_DONG_MIN=12
PUGURIN_ZOOM_COMPLEX_MIN=14
PUGURIN_MAX_MARKERS=500

# 분당 요청 한도 (429 + Retry-After). 개발 중 자주 새로고침해서 걸리면 false로 끌 수 있다
PUGURIN_RATE_LIMIT_ENABLED=true
PUGURIN_RATE_LIMIT_DEVICE_PER_MINUTE=300
PUGURIN_RATE_LIMIT_IP_PER_MINUTE=3000

# 공공데이터포털 실거래가 키. 매매용·전월세용이 따로 발급될 수 있고, 둘 다 있어야 실제 API를 쓴다
PUGURIN_DATA_GO_KR_TRADE_KEY=
PUGURIN_DATA_GO_KR_RENT_KEY=
# 하루 호출 한도(미설정이면 제한 없음). 한도에 닿으면 QuotaExceeded
# PUGURIN_MOLIT_DAILY_CALL_LIMIT=1000

PUGURIN_DATA_DIR=.cache
PUGURIN_REAL_DATA_MONTHS=12
# 카카오 로컬 REST 키 — refresh의 지오코딩, 그리고 /search의 주소 검색(번호가 있는 검색어)에 쓴다. 비우면 주소 검색만 꺼진다
PUGURIN_KAKAO_REST_KEY=
