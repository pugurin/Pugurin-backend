# 운영 서버에서 레포 루트에 .env로 복사해서 쓴다:  cp deploy/.env.example .env
# (API 키는 여기가 아니라 backend/.env에 넣는다)

# DB 비밀번호. 처음 띄우기 전에 정하고 바꾸지 않는다(바꾸려면 docs/DEPLOY.md 참고)
#   만들기: openssl rand -hex 24
PUGURIN_DB_PASSWORD=

# 도메인 (예: api.pugurin.kr). 비우면 http://서버IP 로 뜬다
PUGURIN_DOMAIN=

# worker가 받아 둘 기간(개월). 처음엔 5년치를 채우고 이후엔 매일 최근 3개월만 다시 받는다
PUGURIN_BACKFILL_MONTHS=60
